<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Chain Spectator{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --base: #18181B;
            --surface: #27272A;
            --ink: #FAFAFA;
            --iron: #A1A1AA;
            --rule: #3F3F46;
            --signal: #818CF8;
            --signal-hover: #A5B4FC;
            --signal-subtle: rgba(129, 140, 248, 0.08);
            --confirm-green: #6EE7B7;
            --confirm-green-bg: rgba(110, 231, 183, 0.1);
            --warn-amber: #FCD34D;
            --warn-amber-bg: rgba(252, 211, 77, 0.1);
            --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.3);
            --shadow-md: 0 2px 8px rgba(0, 0, 0, 0.4);
            --radius: 4px;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            font-family: 'Space Grotesk', system-ui, sans-serif;
            background: var(--base);
            color: var(--ink);
            line-height: 1.55;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            font-size: 15px;
            -webkit-font-smoothing: antialiased;
        }

        a { color: var(--signal); text-decoration: none; }
        a:hover { color: var(--signal-hover); }

        .navbar {
            background: var(--surface);
            border-bottom: 1px solid var(--rule);
            padding: 0 1.5rem;
            height: 3.25rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
        }
        .navbar-brand {
            color: var(--ink);
            font-weight: 700;
            font-size: 0.95rem;
            letter-spacing: -0.01em;
            white-space: nowrap;
        }
        .search-form {
            display: flex;
            max-width: 420px;
            flex: 1;
        }
        .search-input {
            flex: 1;
            background: var(--base);
            border: 1px solid var(--rule);
            border-radius: var(--radius);
            color: var(--ink);
            padding: 0.35rem 0.65rem;
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: 0.8rem;
        }
        .search-input::placeholder { color: var(--iron); }
        .search-input:focus { outline: none; border-color: var(--signal); }

        .container {
            max-width: 960px;
            margin: 0 auto;
            padding: 1.5rem 1rem;
            flex: 1;
            width: 100%;
        }

        .card {
            background: var(--surface);
            border: 1px solid var(--rule);
            border-radius: var(--radius);
            box-shadow: var(--shadow-sm);
            padding: 1.25rem;
            margin-bottom: 1rem;
        }

        .footer {
            border-top: 1px solid var(--rule);
            padding: 1rem 1.5rem;
            text-align: center;
            color: var(--iron);
            font-size: 0.75rem;
        }

        table { width: 100%; border-collapse: collapse; }
        th {
            text-align: left;
            color: var(--iron);
            font-weight: 500;
            font-size: 0.75rem;
            padding: 0.5rem 0.65rem;
            border-bottom: 2px solid var(--rule);
        }
        td {
            padding: 0.55rem 0.65rem;
            border-bottom: 1px solid var(--rule);
            font-size: 0.875rem;
        }
        tr:last-child td { border-bottom: none; }
        tr:hover td { background: var(--signal-subtle); }

        .text-right { text-align: right; }
        .text-muted { color: var(--iron); }
        .mono {
            font-family: 'Space Mono', monospace;
            font-size: 0.8rem;
            letter-spacing: -0.02em;
        }

        h1 {
            font-size: 1.35rem;
            font-weight: 700;
            color: var(--ink);
            letter-spacing: -0.02em;
            margin-bottom: 1rem;
        }
        h2 {
            font-size: 1rem;
            font-weight: 600;
            color: var(--ink);
            letter-spacing: -0.01em;
            margin-bottom: 0.75rem;
        }

        .summary-table td:first-child {
            color: var(--iron);
            font-weight: 500;
            font-size: 0.8rem;
            width: 40%;
            white-space: nowrap;
        }
        .fiat {
            color: var(--iron);
            font-size: 0.8rem;
        }

        .badge {
            display: inline-block;
            padding: 0.15rem 0.5rem;
            border-radius: var(--radius);
            font-size: 0.75rem;
            font-weight: 600;
            line-height: 1.4;
        }
        .badge-green {
            background: var(--confirm-green-bg);
            color: var(--confirm-green);
        }
        .badge-amber {
            background: var(--warn-amber-bg);
            color: var(--warn-amber);
        }
        .badge-signal {
            background: var(--signal-subtle);
            color: var(--signal);
        }

        .toggle-btn {
            background: none;
            border: 1px solid var(--rule);
            color: var(--iron);
            padding: 0.3rem 0.65rem;
            border-radius: var(--radius);
            cursor: pointer;
            font-family: 'Space Grotesk', system-ui, sans-serif;
            font-size: 0.75rem;
            font-weight: 500;
        }
        .toggle-btn:hover { border-color: var(--signal); color: var(--signal); }

        @media (max-width: 640px) {
            body { font-size: 14px; }
            .hide-mobile { display: none; }
            .navbar { padding: 0 1rem; flex-wrap: wrap; height: auto; padding-top: 0.65rem; padding-bottom: 0.65rem; }
            .search-form { order: 3; max-width: 100%; width: 100%; margin-top: 0.4rem; }
            .container { padding: 1rem; }
        }
    </style>
    {% block head %}{% endblock %}
</head>
<body>
    <nav class="navbar">
        <a href="/" class="navbar-brand">Chain Spectator</a>
        <form class="search-form" action="/search" method="get">
            <input
                type="text"
                name="q"
                class="search-input"
                placeholder="Block hash, height, txid, or address"
                autocomplete="off"
            >
        </form>
    </nav>

    <main class="container">
        {% block content %}{% endblock %}
    </main>

    <footer class="footer">
        Chain Spectator &middot; Powered by Bitcoin Knots + Fulcrum
    </footer>

    {% block scripts %}{% endblock %}
</body>
</html>
