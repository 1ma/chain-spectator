{% extends "base.html.twig" %}

{% block title %}Block {{ block.height }} - Chain Spectator{% endblock %}

{% block head %}
<style>
    .block-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.25rem;
    }
    .block-nav {
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .block-nav a.arrow {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        border-radius: var(--radius);
        border: 1px solid var(--rule);
        color: var(--iron);
        font-size: 0.9rem;
    }
    .block-nav a.arrow:hover { border-color: var(--signal); color: var(--signal); }
    .block-height {
        font-family: 'Space Mono', monospace;
        font-size: 1.5rem;
        font-weight: 700;
        letter-spacing: -0.02em;
    }
    .close-link {
        color: var(--iron);
        font-size: 1.1rem;
    }
    .close-link:hover { color: var(--ink); }

    .summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 2rem;
    }

    .details-section {
        display: none;
        margin-top: 0.5rem;
    }
    .details-section.open { display: block; }
    .details-toggle {
        text-align: right;
        margin: 0.5rem 0 0;
    }

    .tx-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin: 1.75rem 0 0.75rem;
    }
    .tx-header h2 { margin: 0; }

    .tx-card {
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        padding: 1rem 1.25rem;
        margin-bottom: 0.6rem;
    }
    .tx-card-id {
        font-family: 'Space Mono', monospace;
        font-size: 0.8rem;
        margin-bottom: 0.65rem;
    }
    .tx-io {
        display: grid;
        grid-template-columns: 1fr 1.5rem 1fr;
        gap: 0;
        align-items: start;
    }
    .tx-io-col-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--iron);
        margin-bottom: 0.35rem;
    }
    .tx-io-arrow {
        color: var(--rule);
        text-align: center;
        padding-top: 1.2rem;
        font-size: 1rem;
    }
    .tx-io-entry {
        display: flex;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.2rem 0;
        font-size: 0.8rem;
    }
    .tx-io-entry a {
        font-family: 'Space Mono', monospace;
        font-size: 0.75rem;
    }
    .tx-io-entry .amount {
        font-family: 'Space Mono', monospace;
        font-size: 0.75rem;
        white-space: nowrap;
        color: var(--ink);
    }
    .coinbase-label {
        color: var(--signal);
        font-size: 0.75rem;
        font-weight: 500;
    }
    .op-return-label {
        color: var(--iron);
        font-size: 0.75rem;
    }
    .tx-fee {
        text-align: right;
        color: var(--iron);
        font-size: 0.75rem;
        margin-top: 0.5rem;
        padding-top: 0.4rem;
        border-top: 1px solid var(--rule);
    }

    .pagination {
        display: flex;
        justify-content: center;
        gap: 0.2rem;
        margin-top: 1rem;
    }
    .pagination a, .pagination span {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 1.75rem;
        height: 1.75rem;
        padding: 0 0.35rem;
        border-radius: var(--radius);
        border: 1px solid var(--rule);
        font-size: 0.75rem;
        color: var(--iron);
    }
    .pagination a:hover { border-color: var(--signal); color: var(--signal); }
    .pagination .active {
        background: var(--signal);
        color: #fff;
        border-color: var(--signal);
    }
    .pagination .disabled { opacity: 0.3; }
    .pagination .ellipsis { border: none; }

    @media (max-width: 640px) {
        .summary-grid { grid-template-columns: 1fr; }
        .tx-io { grid-template-columns: 1fr; }
        .tx-io-arrow { padding: 0.25rem 0; }
        .block-height { font-size: 1.2rem; }
    }
</style>
{% endblock %}

{% block content %}
<div class="block-header">
    <div class="block-nav">
        <a href="/block/{{ block.prev_hash }}" class="arrow">&lsaquo;</a>
        <span class="block-height">{{ block.height|number_format }}</span>
        <a href="/block/{{ block.next_hash }}" class="arrow">&rsaquo;</a>
    </div>
    <a href="/" class="close-link">&times;</a>
</div>

<div class="card">
    <div class="summary-grid">
        <table class="summary-table">
            <tr>
                <td>Hash</td>
                <td class="mono">{{ block.hash[:10] }}...{{ block.hash[-6:] }}</td>
            </tr>
            <tr>
                <td>Timestamp</td>
                <td>{{ block.timestamp }}</td>
            </tr>
            <tr>
                <td>Size</td>
                <td class="mono">{{ block.size|number_format }} bytes</td>
            </tr>
            <tr>
                <td>Weight</td>
                <td class="mono">{{ block.weight|number_format }} WU</td>
            </tr>
        </table>
        <table class="summary-table">
            <tr>
                <td>Fee span</td>
                <td class="mono">{{ block.fee_span_min }}–{{ block.fee_span_max }} sat/vB</td>
            </tr>
            <tr>
                <td>Median fee</td>
                <td class="mono">~{{ block.median_fee }} sat/vB <span class="fiat">{{ block.median_fee_fiat }}</span></td>
            </tr>
            <tr>
                <td>Total fees</td>
                <td class="mono">{{ block.total_fees_btc }} BTC <span class="fiat">{{ block.total_fees_fiat }}</span></td>
            </tr>
            <tr>
                <td>Subsidy + fees</td>
                <td class="mono">{{ block.reward_btc }} BTC <span class="fiat">{{ block.reward_fiat }}</span></td>
            </tr>
            <tr>
                <td>Miner</td>
                <td>{{ block.miner }}</td>
            </tr>
        </table>
    </div>
</div>

<div class="details-toggle">
    <button class="toggle-btn" onclick="document.getElementById('block-details').classList.toggle('open')">Details</button>
</div>

<div id="block-details" class="details-section">
    <div class="card">
        <div class="summary-grid">
            <table class="summary-table">
                <tr>
                    <td>Version</td>
                    <td class="mono">{{ block.version }}</td>
                </tr>
                <tr>
                    <td>Bits</td>
                    <td class="mono">{{ block.bits }}</td>
                </tr>
                <tr>
                    <td>Merkle root</td>
                    <td class="mono" style="word-break: break-all; font-size: 0.7rem;">{{ block.merkle_root }}</td>
                </tr>
            </table>
            <table class="summary-table">
                <tr>
                    <td>Difficulty</td>
                    <td class="mono">{{ block.difficulty }}</td>
                </tr>
                <tr>
                    <td>Nonce</td>
                    <td class="mono">{{ block.nonce }}</td>
                </tr>
            </table>
        </div>
    </div>
</div>

<div class="tx-header">
    <h2>{{ block.tx_count|number_format }} transactions</h2>
</div>

{% for tx in transactions %}
<div class="tx-card">
    <div class="tx-card-id">
        <a href="/tx/{{ tx.txid }}">{{ tx.txid[:10] }}...{{ tx.txid[-6:] }}</a>
    </div>
    <div class="tx-io">
        <div>
            <div class="tx-io-col-label">Inputs</div>
            {% for input in tx.inputs %}
            <div class="tx-io-entry">
                {% if input.coinbase is defined and input.coinbase %}
                    <span class="coinbase-label">Coinbase</span>
                {% else %}
                    <a href="/address/{{ input.address }}">{{ input.address }}</a>
                    <span class="amount">{{ input.value }}</span>
                {% endif %}
            </div>
            {% endfor %}
        </div>
        <div class="tx-io-arrow">&rarr;</div>
        <div>
            <div class="tx-io-col-label">Outputs</div>
            {% for output in tx.outputs %}
            <div class="tx-io-entry">
                {% if output.op_return is defined and output.op_return %}
                    <span class="op-return-label">OP_RETURN</span>
                {% else %}
                    <a href="/address/{{ output.address }}">{{ output.address }}</a>
                    <span class="amount">{{ output.value }}</span>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>
    <div class="tx-fee">
        {{ tx.fee|number_format }} sats{% if tx.fee_rate %} · {{ tx.fee_rate }} sat/vB{% endif %}
    </div>
</div>
{% endfor %}

<div class="pagination">
    <span class="disabled">&lsaquo;</span>
    {% for p in 1..5 %}
        {% if p == page %}
            <span class="active">{{ p }}</span>
        {% else %}
            <a href="/block/{{ block.hash }}?page={{ p }}">{{ p }}</a>
        {% endif %}
    {% endfor %}
    <span class="ellipsis">...</span>
    <a href="/block/{{ block.hash }}?page={{ total_pages }}">{{ total_pages }}</a>
    <a href="/block/{{ block.hash }}?page=2">&rsaquo;</a>
</div>
{% endblock %}
