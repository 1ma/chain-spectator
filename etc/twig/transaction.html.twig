{% extends "base.html.twig" %}

{% block title %}Tx {{ tx.txid[:16] }}... - Chain Spectator{% endblock %}

{% block head %}
<style>
    .tx-header-block {
        margin-bottom: 1.25rem;
    }
    .tx-label {
        font-size: 0.8rem;
        color: var(--iron);
        font-weight: 500;
        margin-bottom: 0.25rem;
    }
    .tx-id-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }
    .tx-id {
        font-family: 'Space Mono', monospace;
        font-size: 0.8rem;
        word-break: break-all;
        line-height: 1.5;
        flex: 1;
        min-width: 0;
    }

    .summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 2rem;
    }

    .feature-badge {
        display: inline-block;
        padding: 0.1rem 0.4rem;
        border-radius: var(--radius);
        font-size: 0.7rem;
        font-weight: 600;
        background: var(--signal-subtle);
        color: var(--signal);
        margin-right: 0.15rem;
    }

    .section-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 1.75rem 0 0.75rem;
    }
    .section-bar h2 { margin: 0; }

    .io-card {
        background: var(--surface);
        border: 1px solid var(--rule);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        padding: 1.25rem;
    }
    .io-grid {
        display: grid;
        grid-template-columns: 1fr 1.5rem 1fr;
        gap: 0;
        align-items: start;
    }
    .io-col-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--iron);
        margin-bottom: 0.5rem;
    }
    .io-arrow {
        color: var(--rule);
        text-align: center;
        padding-top: 1.5rem;
        font-size: 1rem;
    }
    .io-entry {
        padding: 0.45rem 0;
        border-bottom: 1px solid var(--rule);
    }
    .io-entry:last-child { border-bottom: none; }
    .io-index {
        font-size: 0.65rem;
        color: var(--iron);
        font-weight: 600;
        font-family: 'Space Mono', monospace;
    }
    .io-addr {
        font-family: 'Space Mono', monospace;
        font-size: 0.75rem;
        display: block;
        margin: 0.1rem 0;
    }
    .io-value {
        font-family: 'Space Mono', monospace;
        font-size: 0.8rem;
    }
    .io-source {
        font-size: 0.7rem;
        color: var(--iron);
    }
    .io-source a {
        font-family: 'Space Mono', monospace;
        font-size: 0.7rem;
    }
    .spent-tag {
        font-size: 0.65rem;
        font-weight: 600;
        padding: 0.1rem 0.3rem;
        border-radius: 2px;
    }
    .spent-tag.spent {
        background: var(--base);
        color: var(--iron);
    }
    .spent-tag.unspent {
        background: var(--confirm-green-bg);
        color: var(--confirm-green);
    }

    .io-totals {
        margin-top: 0.75rem;
        padding-top: 0.65rem;
        border-top: 2px solid var(--rule);
    }
    .io-totals-row {
        display: flex;
        justify-content: space-between;
        padding: 0.15rem 0;
        font-size: 0.8rem;
    }
    .io-totals-row .label { color: var(--iron); font-weight: 500; }
    .io-totals-row .value { font-family: 'Space Mono', monospace; font-size: 0.8rem; }

    .details-section {
        display: none;
        margin-top: 0.75rem;
    }
    .details-section.open { display: block; }

    .block-link {
        margin-top: 1rem;
        font-size: 0.8rem;
        color: var(--iron);
    }

    @media (max-width: 640px) {
        .summary-grid { grid-template-columns: 1fr; }
        .io-grid { grid-template-columns: 1fr; }
        .io-arrow { padding: 0.25rem 0; }
    }
</style>
{% endblock %}

{% block content %}
<div class="tx-header-block">
    <div class="tx-label">Transaction</div>
    <div class="tx-id-row">
        <div class="tx-id">{{ tx.txid }}</div>
        {% if tx.confirmed %}
            <span class="badge badge-green">{{ tx.confirmations|number_format }} confirmations</span>
        {% else %}
            <span class="badge badge-amber">Unconfirmed</span>
        {% endif %}
    </div>
</div>

<div class="card">
    <div class="summary-grid">
        <table class="summary-table">
            {% if tx.confirmed %}
            <tr>
                <td>Timestamp</td>
                <td>{{ tx.timestamp }}</td>
            </tr>
            <tr>
                <td>Confirmed after</td>
                <td>{{ tx.confirmed_after }}</td>
            </tr>
            {% else %}
            <tr>
                <td>First seen</td>
                <td>{{ tx.first_seen }}</td>
            </tr>
            <tr>
                <td>ETA</td>
                <td>{{ tx.eta }}</td>
            </tr>
            {% endif %}
            <tr>
                <td>Features</td>
                <td>
                    {% for feature in tx.features %}
                        <span class="feature-badge">{{ feature }}</span>
                    {% endfor %}
                </td>
            </tr>
        </table>
        <table class="summary-table">
            <tr>
                <td>Fee</td>
                <td class="mono">{{ tx.fee_sats|number_format }} sats <span class="fiat">{{ tx.fee_fiat }}</span></td>
            </tr>
            <tr>
                <td>Fee rate</td>
                <td class="mono">{{ tx.fee_rate }} sat/vB</td>
            </tr>
            <tr>
                <td>Effective fee rate</td>
                <td class="mono">{{ tx.effective_fee_rate }} sat/vB</td>
            </tr>
            {% if tx.confirmed %}
            <tr>
                <td>Miner</td>
                <td>{{ tx.miner }}</td>
            </tr>
            {% endif %}
        </table>
    </div>
</div>

<div class="section-bar">
    <h2>Inputs &amp; Outputs</h2>
    <button class="toggle-btn" onclick="document.getElementById('tx-details').classList.toggle('open')">Details</button>
</div>

<div class="io-card">
    <div class="io-grid">
        <div>
            <div class="io-col-label">Inputs ({{ inputs|length }})</div>
            {% for input in inputs %}
            <div class="io-entry">
                <span class="io-index">#{{ input.index }}</span>
                <a href="/address/{{ input.address }}" class="io-addr">{{ input.address[:10] }}...{{ input.address[-6:] }}</a>
                <span class="io-value">{{ input.value }} BTC</span>
                <div class="io-source">
                    from <a href="/tx/{{ input.prev_txid }}">{{ input.prev_txid[:10] }}...{{ input.prev_txid[-4:] }}</a>:{{ input.prev_vout }}
                </div>
            </div>
            {% endfor %}
        </div>
        <div class="io-arrow">&rarr;</div>
        <div>
            <div class="io-col-label">Outputs ({{ outputs|length }})</div>
            {% for output in outputs %}
            <div class="io-entry">
                <span class="io-index">#{{ output.index }}</span>
                <a href="/address/{{ output.address }}" class="io-addr">{{ output.address[:10] }}...{{ output.address[-6:] }}</a>
                <span class="io-value">{{ output.value }} BTC</span>
                {% if output.spent %}
                    <span class="spent-tag spent">spent</span>
                {% else %}
                    <span class="spent-tag unspent">unspent</span>
                {% endif %}
            </div>
            {% endfor %}
        </div>
    </div>

    <div class="io-totals">
        <div class="io-totals-row">
            <span class="label">Total input</span>
            <span class="value">{{ tx.total_input_btc }} BTC</span>
        </div>
        <div class="io-totals-row">
            <span class="label">Total output</span>
            <span class="value">{{ tx.total_output_btc }} BTC</span>
        </div>
        <div class="io-totals-row">
            <span class="label">Fee</span>
            <span class="value">{{ tx.fee_btc }} BTC ({{ tx.fee_sats|number_format }} sats)</span>
        </div>
    </div>
</div>

<div id="tx-details" class="details-section">
    <div class="card">
        <div class="summary-grid">
            <table class="summary-table">
                <tr>
                    <td>Size</td>
                    <td class="mono">{{ tx.size|number_format }} bytes</td>
                </tr>
                <tr>
                    <td>Virtual size</td>
                    <td class="mono">{{ tx.vsize|number_format }} vB</td>
                </tr>
                <tr>
                    <td>Weight</td>
                    <td class="mono">{{ tx.weight|number_format }} WU</td>
                </tr>
            </table>
            <table class="summary-table">
                <tr>
                    <td>Version</td>
                    <td class="mono">{{ tx.version }}</td>
                </tr>
                <tr>
                    <td>Locktime</td>
                    <td class="mono">{{ tx.locktime|number_format }}</td>
                </tr>
                <tr>
                    <td>Sigops</td>
                    <td class="mono">{{ tx.sigops }}</td>
                </tr>
            </table>
        </div>
    </div>
</div>

{% if tx.confirmed %}
<div class="block-link">
    Included in block <a href="/block/{{ tx.block_hash }}">{{ tx.block_height|number_format }}</a>
</div>
{% endif %}
{% endblock %}
