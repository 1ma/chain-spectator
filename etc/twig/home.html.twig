{% extends "base.html.twig" %}

{% block title %}Chain Spectator{% endblock %}

{% block head %}
<style>
    .hero {
        padding: 2.5rem 0 2rem;
        text-align: center;
    }
    .chain-tip {
        font-family: 'Space Mono', monospace;
        font-size: 3.5rem;
        font-weight: 700;
        letter-spacing: -0.03em;
        color: var(--ink);
        line-height: 1.1;
    }
    .chain-tip a { color: inherit; }
    .chain-tip a:hover { color: var(--signal); }
    .chain-meta {
        color: var(--iron);
        font-size: 0.85rem;
        margin-top: 0.35rem;
    }
    .hero-search {
        max-width: 480px;
        margin: 1.75rem auto 0;
        display: flex;
        gap: 0;
    }
    .hero-search input {
        flex: 1;
        background: var(--surface);
        border: 1px solid var(--rule);
        border-right: none;
        border-radius: var(--radius) 0 0 var(--radius);
        color: var(--ink);
        padding: 0.55rem 0.85rem;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-size: 0.85rem;
    }
    .hero-search input::placeholder { color: var(--iron); }
    .hero-search input:focus { outline: none; border-color: var(--signal); }
    .hero-search button {
        background: var(--signal);
        color: #fff;
        border: 1px solid var(--signal);
        border-radius: 0 var(--radius) var(--radius) 0;
        padding: 0.55rem 1rem;
        font-family: 'Space Grotesk', system-ui, sans-serif;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        white-space: nowrap;
    }
    .hero-search button:hover { background: var(--signal-hover); border-color: var(--signal-hover); }

    .blocks-table tr { cursor: pointer; }
    .blocks-table .height a {
        font-family: 'Space Mono', monospace;
        font-weight: 700;
        font-size: 0.85rem;
    }
    .blocks-table .data {
        font-family: 'Space Mono', monospace;
        font-size: 0.8rem;
    }

    @media (max-width: 640px) {
        .chain-tip { font-size: 2.5rem; }
    }
</style>
{% endblock %}

{% block content %}
<div class="hero">
    <div class="chain-tip">
        <a href="/block/{{ blocks[0].hash }}">{{ blocks[0].height|number_format }}</a>
    </div>
    <div class="chain-meta">
        latest block &middot; {{ blocks[0].time_ago }} &middot; {{ blocks[0].miner }}
    </div>
    <form class="hero-search" action="/search" method="get">
        <input
            type="text"
            name="q"
            placeholder="Block hash, height, txid, or address"
            autocomplete="off"
            autofocus
        >
        <button type="submit">Search</button>
    </form>
</div>

<div class="card">
    <h2>Latest Blocks</h2>
    <div style="overflow-x: auto;">
        <table class="blocks-table">
            <thead>
                <tr>
                    <th>Height</th>
                    <th>Time</th>
                    <th class="text-right">Tx</th>
                    <th class="text-right hide-mobile">Size</th>
                    <th>Miner</th>
                </tr>
            </thead>
            <tbody>
                {% for block in blocks %}
                <tr>
                    <td class="height"><a href="/block/{{ block.hash }}">{{ block.height|number_format }}</a></td>
                    <td class="text-muted">{{ block.time_ago }}</td>
                    <td class="text-right data">{{ block.tx_count|number_format }}</td>
                    <td class="text-right data hide-mobile">{{ block.size_display }}</td>
                    <td>{{ block.miner }}</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
